@article{esteban2025financial,
  abbr      = {Journal Article},
  title     = {Financial incentives and information provision for post-pandemic primary care quality recovery: a longitudinal study in Catalonia},
  author    = {Esteban-Fabró, Roger and Coma, Ermengol and Marin-Gomez, Francesc X. and Hermosilla, Eduardo and Méndez-Boo, Leonardo and Guiriguet, Carolina and Facchini, Gabriel and Violán, Concepción and Nicodemo, Catia and Vidal-Alaball, Josep},
  journal   = {British Journal of General Practice},
  year      = {2025},
  doi       = {10.3399/bjgp.2025.0518},
  abstract  = {The COVID-19 pandemic disrupted primary care services worldwide, reducing quality of care. We assess whether information provision and financial incentives to primary care professionals supported quality of care recovering to pre-pandemic levels. Data on 37 quality-of-care indicators from 287 primary care practices (5,250,531 adults) in Catalonia were analysed monthly from 2019 until 2024. Financial incentives were suspended in 2020; 13 indicators were reintegrated into pay-for-performance schemes in 2021, while 24 remained out of the schemes until 2023. Early incentivisation doubled the likelihood of recovery before 2023, with effects varying by indicator type. However, many practices recovered late-incentivised indicators when they were informed only, before financial incentives resumed. Financial incentives accelerated quality-of-care recovery after a system shock, particularly when tailored to indicator types and practice contexts, and complemented by timely information provision.},
  bibtex_show = {true}
}

@article{esteban2024information,
  abbr      = {Journal Article},
  title     = {Information provision and financial incentives in Catalonia's public primary care (2010--2019): an interrupted time series analysis},
  author    = {Esteban-Fabró, Roger and Coma, Ermengol and Hermosilla, Eduardo and Méndez-Boo, Leonardo and Guiriguet, Carolina and Facchini, Gabriel and Nicodemo, Catia and Vidal-Alaball, Josep},
  journal   = {The Lancet Regional Health -- Europe},
  volume    = {47},
  pages     = {101102},
  year      = {2024},
  doi       = {10.1016/j.lanepe.2024.101102},
  abstract  = {The relative efficacy of information provision versus financial incentives in improving primary care quality remains a critical, unresolved question. We investigated these two strategies in Catalonia's public primary care system from 2010 to 2019: an innovative online platform providing real-time quality indicator information, and targeted economic incentives for achieving indicator goals. We conducted an interrupted time series regression analysis on data from 272 primary care practices (5,628,080 patients). Informed indicators showed positive impacts in 75 percent of cases, and incentivized indicators in 64 percent of cases. Both interventions were associated with step reductions in variability and significant trend improvements. Our findings reveal that information provision alone can match or even surpass the impact of financial incentives in improving care quality and reducing practice variability, offering a cost-effective, scalable approach to primary care quality enhancement.},
  selected  = {true},
  bibtex_show = {true}
}

@article{facchini2022low,
  abbr      = {Journal Article},
  title     = {Low staffing in the maternity ward: Keep calm and call the surgeon},
  author    = {Facchini, Gabriel},
  journal   = {Journal of Economic Behavior \& Organization},
  volume    = {197},
  pages     = {370--394},
  year      = {2022},
  doi       = {10.1016/j.jebo.2022.03.013},
  abstract  = {This paper examines how workload affects the provision of care in a large but understudied segment of the healthcare sector -- maternity wards. I use detailed patient-level administrative data on childbirth, and exploit quasi-random assignment of unscheduled patients to different staffing ratios. I find that the probability of C-section increases at a decreasing rate with workload. I show that this result is not attributable to patients' differential sorting across staffing levels. Instead, I find evidence that C-sections are used to alleviate midwives' workload -- they are faster than vaginal births and performed by physicians. I also exploit patient's civil status to determine whether the effect varies with patient's bargaining power -- single women are on average more likely to be alone in the delivery room. Consistent with induced demand, only single patients are more likely to receive a C-section when admitted at high workload levels.},
  award     = {Best Paper Award for Young Researchers, Centro Einaudi (2018); Young Researcher Award for Best Paper, Italian Health Economics Association (2015)},
  selected  = {true},
  bibtex_show = {true}
}

@article{facchini2021forgetting,
  abbr      = {Journal Article},
  title     = {Forgetting-by-not-doing: The case of surgeons and cesarean sections},
  author    = {Facchini, Gabriel},
  journal   = {Health Economics},
  year      = {2021},
  doi       = {10.1002/hec.4460},
  abstract  = {This paper provides new evidence on the link between patient outcome and physician experience. Using birth certificates data from a large hospital in Italy, I analyze whether cesarean section surgeons who have performed more procedures in the recent past observe an improvement in performance. By using data from the Italian health care system, where patients are not allowed to choose their physician, I lower concerns of potential reverse causality (selective referral). I find evidence indicating a strong learning-by-doing effect: for emergent cases, a one standard deviation increase in recent experience reduces the likelihood of neonatal intensive care unit admission by nearly 3.2 percentage points (13.8 percent) and of being born with a low Apgar Score by about 1.9 percentage points (13.2 percent), all else equal. This effect is not present for the case of elective C-sections.},
  selected  = {true},
  bibtex_show = {true}
}

@article{caceres2021intergroup,
  abbr      = {Journal Article},
  title     = {Intergroup contact and nation building: Evidence from military service in Spain},
  author    = {Cáceres-Delpiano, Julio and De Moragas, Antoni-Italo and Facchini, Gabriel and González, Ignacio},
  journal   = {Journal of Public Economics},
  volume    = {201},
  pages     = {104477},
  year      = {2021},
  doi       = {10.1016/j.jpubeco.2021.104477},
  pdf       = {https://e-archivo.uc3m.es/bitstream/handle/10016/31507/we2015.pdf},
  abstract  = {We study the long-term effects of intergroup contact on nation building by exploiting a national lottery that randomly allocated conscripts to different military areas across Spain. For men born in regions featuring a strong regional identity, we find that being assigned to military service in a region different from one's region of birth substantially increases self-identification as Spanish and reduces the likelihood of voting for a regionalist party. Moreover, in support of intergroup contact as the main mechanism behind these results, we find that movers are more likely to have friends from another region than nonmovers.},
  song      = {https://youtu.be/myVi6pVYYb8},
  song_title = {Jorge Drexler — Milonga del moro judío},
  selected  = {true},
  bibtex_show = {true}
}

@article{berniell2021covid,
  abbr      = {Journal Article},
  title     = {COVID-19 lockdown and domestic violence: Evidence from internet-search behavior in 11 countries},
  author    = {Berniell, Inés and Facchini, Gabriel},
  journal   = {European Economic Review},
  volume    = {136},
  pages     = {103775},
  year      = {2021},
  doi       = {10.1016/j.euroecorev.2021.103775},
  pdf       = {https://www.cedlas.econo.unlp.edu.ar/wp/wp-content/uploads/doc_cedlas273.pdf},
  abstract  = {We study the impact of the COVID-19 pandemic on domestic violence in 11 countries with different ex-ante incidence of domestic violence (DV) and lockdown intensity. We use a novel measure of DV incidents that allows us to make cross-country comparisons: a Google search intensity index of DV-related topics. Our difference-in-difference estimates show an increase in DV search intensity after lockdown (31 percent), with larger effects as more people stayed at home (measured with Google Mobility Data). The peak of the increase in DV appears, on average, 7 weeks after the introduction of the lockdown. While we observe that the positive impacts on DV is a widespread phenomenon in developed countries is more than twice as strong as in Latin American countries. We show that the difference in impact correlates with the intensity of compliance with stay-at-home measures in the two groups.},
  selected  = {true},
  bibtex_show = {true}
}

