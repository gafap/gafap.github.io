---
layout: default
---
{% comment %}
  LOCAL OVERRIDE of al_folio_core's _layouts/about.liquid.

  Four changes from the gem's version:
  1. The profile photo block is moved ABOVE the <header>, so that the floated
     image sits alongside the name, subtitle and bio rather than only alongside
     the bio. (A float only affects content that comes after it in the markup.)
  2. The whole name is bold, instead of just the first name.
  3. An optional second photo for dark mode: set `profile.image_dark` in the
     page front matter and it replaces `profile.image` whenever the dark theme
     is active. Both are rendered and one is hidden with the theme's existing
     `.only-light` / `.only-dark` classes, so the swap happens instantly on
     toggle with no second request. Keep the two images the same dimensions,
     otherwise the page reflows when the theme changes.
  4. Support for a page-scoped `_styles` block, copied verbatim from the gem's
     _layouts/page.liquid. The gem wires `_styles` into page.liquid, post.liquid
     and book-review.liquid but not into about.liquid, so a `_styles` block in
     _pages/about.md was otherwise ignored without warning.

  After `bundle update` of al_folio_core, compare against the gem's version with:
    bundle exec al-folio upgrade overrides diff _layouts/about.liquid
{% endcomment %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {% if page.profile.image_dark %}
            {% assign profile_image_dark_path = page.profile.image_dark | prepend: 'assets/img/' %}
            <div class="only-light">
              {%
                include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes
                alt=page.profile.image cache_bust=true
              %}
            </div>
            <div class="only-dark">
              {%
                include figure.liquid loading="eager" path=profile_image_dark_path class=profile_image_class sizes=sizes
                alt=page.profile.image_dark cache_bust=true
              %}
            </div>
          {% else %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <header class="post-header">
      <h1 class="post-title">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</span>
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="desc">{{ page.subtitle }}</p>
    </header>

    {% comment %}
      The contact icons live INSIDE the clearfix wrapper, immediately after the bio.
      That keeps them in the same text column as the bio, so they sit to the left of
      the floated photo. In the gem's version they came after the news section and
      after the float had been cleared, so they rendered full-width below everything.
    {% endcomment %}
    <div class="clearfix">
      {{ content }}

      <!-- Social -->
      {% if page.social %}
        <div class="social">
          <div class="contact-icons">{% social_links %}</div>

          {% if site.contact_note %}
            <div class="contact-note">{{ site.contact_note }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
